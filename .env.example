UPSTREAM_URL=http://localhost:11434
HIGH_PRIORITY_UTIL_THRESHOLD=80

# Minimum total VRAM (MB) used by external processes before the GPU is considered busy
# when per-process figures are trustworthy (NVML / Linux). On Windows WDDM, PDH MB
# values are unreliable for games — presence of any non-desktop GPU process counts
# as busy instead. 2000 keeps small NVML noise from false positives on Linux.
# EXTERNAL_VRAM_THRESHOLD_MB=2000

# When per-process VRAM is unavailable (typical on Windows), secondary util % signal.
# EXTERNAL_UTIL_FALLBACK_THRESHOLD=40

# Seconds the GPU must stay free before restarting the LLM after a drain.
# SERVER_RESTART_STABLE_SECS=5

# JSON array of LLM server process names that own the GPU legitimately.
# Must be JSON in .env — pydantic-settings parses list fields as JSON before validators run.
# Games and editors must NOT be listed here. Desktop launchers (Steam, Epic, browsers, …)
# are filtered separately via the hardcoded allowlist in app/windows_gpu.py.
# IGNORED_GPU_PROCESSES=["ollama","ollama_llama_server","llama-server","lmstudio"]

# Soft-stop the LLM when a non-desktop GPU process appears (any game / editor).
# Prefer soft terminate — force-kill of CUDA runners on WDDM can wedge exclusive
# fullscreen until reboot.
# SERVER_PROCESS=ollama
# SERVER_KILL_PROCESSES=true
# SERVER_FORCE_KILL=false
# SERVER_START_COMMAND=ollama serve

# After restart: remember models from /api/ps (and/or SERVER_PRELOAD_MODEL), preload
# them while state is still STARTING (clients get 429), then open the gate.
# SERVER_PRELOAD_ON_START=true
# SERVER_PRELOAD_KEEP_ALIVE=24h
# SERVER_PRELOAD_MODEL=gemma4:12b-it-q4_K_M

# Command to pull/download a model before serving it; {model} is replaced with the model name
# PULL_COMMAND=huggingface-cli download {model}

# Seconds to wait for a model pull to complete before giving up
# PULL_HOLD_TIMEOUT_SECS=300

# Seconds after a model load starts during which the proxy will not evict it for GPU pressure
# MODEL_LOAD_IMMUNITY_SECS=60

# Port the proxy is documented as using. The real listen port is set by uvicorn
# (--port) or scripts/start-gate.ps1 — changing this alone does not rebind.
# PROXY_PORT=11435
