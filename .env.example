UPSTREAM_URL=http://localhost:11434
HIGH_PRIORITY_UTIL_THRESHOLD=80
# Minimum total VRAM (MB) used by external processes before the GPU is considered busy.
# Prevents background Windows apps (dwm.exe, browser GPU processes, Discord) from
# triggering backoff. After running setup-windows.ps1, 200 MB is a reasonable value.
# EXTERNAL_VRAM_THRESHOLD_MB=500
# Space-separated list of process names to ignore (supports Ollama, vLLM, llama.cpp, LM Studio, and any OpenAI-compatible or Ollama-compatible server)
# IGNORED_GPU_PROCESSES=ollama llama-server lmstudio

# Command to pull/download a model before serving it; {model} is replaced with the model name
# PULL_COMMAND=huggingface-cli download {model}

# Seconds to wait for a model pull to complete before giving up
# PULL_HOLD_TIMEOUT_SECS=300

# Seconds after a model load starts during which the proxy will not evict it for GPU pressure
# MODEL_LOAD_IMMUNITY_SECS=60

# Port the proxy listens on. NOTE: this must also match the uvicorn --port flag in the Dockerfile CMD;
# changing this setting alone does not rebind the server port.
# PROXY_PORT=11435
